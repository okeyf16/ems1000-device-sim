# Copy to .env and fill in. Never commit .env.
#
# One device: set the generic variable.
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<your-hub>.azure-devices.net;DeviceId=ems-sim-01;SharedAccessKey=<key>
#
# Several devices: one variable per device id (dashes -> underscores, upper case).
# IOTHUB_CONN_EMS_SIM_01=HostName=...;DeviceId=ems-sim-01;SharedAccessKey=...
# IOTHUB_CONN_EMS_SIM_02=HostName=...;DeviceId=ems-sim-02;SharedAccessKey=...
# Staging API key for the panel's cloud view (optional; one of the staging output api_keys)
# EMS_API_KEY=
